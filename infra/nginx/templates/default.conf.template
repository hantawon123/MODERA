# 서버 리버스 프록시 설정. 실제 위치는 /home/ubuntu/infra/nginx/conf.d/default.conf 이며
# infra-nginx-1 컨테이너에 /etc/nginx/conf.d 로 마운트된다.
#
# ⚠️ Jenkins 는 이 파일을 배포하지 않는다(AI Deploy 단계는 ai/ai_main/docker-compose.yml
#    만 복사한다). 고친 뒤에는 서버에 직접 반영해야 한다:
#
#      scp infra/nginx/conf.d/default.conf ubuntu@${PUBLIC_HOST}:/home/ubuntu/infra/nginx/conf.d/
#      ssh ubuntu@${PUBLIC_HOST} 'docker exec infra-nginx-1 nginx -t && docker exec infra-nginx-1 nginx -s reload'
#
#    nginx -t 를 반드시 먼저 통과시킬 것. upstream 호스트명이 해석되지 않으면 nginx 가
#    설정 로드를 거부하고, 그 상태로 reload 하면 프록시 전체가 죽는다.
#    (2026-07-23 에 modera-spring 컨테이너 부재로 실제 이 상태였다. 아래 주석 참고)

server {
    listen 80;
    server_name ${PUBLIC_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_HOST};

    ssl_certificate     /etc/letsencrypt/live/${PUBLIC_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_HOST}/privkey.pem;

    # Docker 내장 DNS. proxy_pass 에 호스트명을 글자로 그대로 쓰면 nginx 는 설정을
    # 읽는 순간 1회만 DNS 를 조회하고 그 IP 를 굳혀 버린다. Jenkins 배포로 컨테이너가
    # 재생성되면 IP 가 바뀌는데 nginx 는 옛 IP 로 계속 보내서 502 가 난다
    # (2026-07-30 에 /api/v1/ 이 실제로 이 상태였다 — 재배포 후 앱 전체 502).
    #
    # 아래 upstream 들을 `set` 변수로 넘기는 이유가 이것이다. proxy_pass 에 변수를
    # 쓰면 nginx 가 요청 시점에 DNS 를 다시 해석한다. resolver 와 변수 **둘 다**
    # 있어야 동작한다 — 변수 없이 resolver 만 넣어도 여전히 기동 시 1회 조회다.
    # 되돌리지 말 것. 되돌리면 AI 재배포마다 수동 nginx reload 가 필요해진다.
    resolver 127.0.0.11 valid=10s;

    # Jenkins webhook 수신 (GitLab → Jenkins). /project/ 경로만 노출
    location /project/ {
        proxy_pass http://jenkins:8080;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── AI 서버 (FastAPI) — 앱이 쓰는 정규 경로 ──────────────────────────
    # prefix 없이 그대로 넘긴다(proxy_pass 끝에 / 없음).
    #   https://host/api/v1/images/upload → ai-service:8000/api/v1/images/upload
    #
    # /ai/ 가 아니라 이 경로를 쓰는 이유: 서버가 응답에 담는 imageUrl·thumbnailUrl 이
    # "/api/v1/images/9/source" 처럼 루트 기준 상대경로다. prefix 를 씌우면 앱이
    # 그 값에 /ai 를 직접 붙여야 하는데, 그건 앱 코드 변경이다.
    #
    # ⚠️ 원래 Spring(modera-spring)이 쓰던 경로다. Spring 이 돌아오면 둘 중 하나가
    #    경로를 옮겨야 한다(아래 주석 처리된 블록 참고).
    location /api/v1/ {
        # 변수로 넘겨 요청 시점 DNS 해석(위 resolver 주석 참고).
        # URI 부분을 붙이지 않으므로 원본 경로가 그대로 전달된다.
        # set $ai_upstream http://ai-service:8000;
        set $ai_upstream http://ai-service:8000;
        proxy_pass $ai_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 10s;
        proxy_send_timeout   120s;
        proxy_read_timeout   120s;
        client_max_body_size  10m;
    }

    # 진단·문서용 보조 경로(/ai/docs, /ai/health). 앱은 위 /api/v1/ 을 쓴다.
    location /ai/ {
        # /ai 접두사를 떼고 넘긴다(/ai/health → /health).
        # proxy_pass 에 변수를 쓸 때는 끝 슬래시(`$var/`)로 접두사를 떼지 못한다 —
        # 변수를 쓰면 URI 부분이 "접두사 치환" 이 아니라 "요청 URI 전체 교체" 로
        # 해석되어 /ai/health 가 그냥 / 로 가 버린다. 그래서 rewrite 로 뗀다.
        set $ai_upstream_diag http://ai-service:8000;
        rewrite ^/ai/(.*)$ /$1 break;
        proxy_pass $ai_upstream_diag;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 분석 요청은 Gemini 응답을 기다려 길어질 수 있다.
        proxy_connect_timeout 10s;
        proxy_send_timeout   120s;
        proxy_read_timeout   120s;
        client_max_body_size  10m;
    }

    # ── MinIO (presigned 업로드/조회) ────────────────────────────────────
    # S3_PUBLIC_ENDPOINT=https://${PUBLIC_HOST} (prefix 없음) 이 여기로 온다.
    # 앱이 presigned PUT/GET 으로 직접 붙으므로 AI 서버를 거치지 않는다.
    #
    # ⚠️ prefix 를 두면 안 된다. SigV4 는 경로(canonical URI)까지 서명하는데,
    #    /s3/ 로 받아 proxy_pass 끝 슬래시로 벗겨내면 서버가 서명한 경로
    #    (/s3/pictures/...)와 MinIO 가 계산하는 경로(/pictures/...)가 달라져
    #    SignatureDoesNotMatch 403 이 난다. 그래서 버킷 경로를 그대로 노출하고
    #    proxy_pass 에 끝 슬래시를 두지 않아 경로를 손대지 않는다.
    #    (SigV2 는 서명 대상 경로가 /버킷/키 뿐이라 우연히 통했던 것이다.)
    #
    #  - Host $host          : SigV4 는 host 도 서명 대상이다. 바꾸면 403.
    #  - client_max_body_size: 기본 1MB 라 5MB 스크린샷이 413 으로 잘린다.
    location /pictures/ {
        set $minio_upstream http://minio:9000;
        proxy_pass $minio_upstream;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version      1.1;
        proxy_request_buffering off;
        client_max_body_size    10m;
        proxy_connect_timeout   10s;
        proxy_send_timeout      120s;
        proxy_read_timeout      120s;
    }

    location /thumbnails/ {
        set $minio_upstream_thumb http://minio:9000;
        proxy_pass $minio_upstream_thumb;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version    1.1;
        proxy_connect_timeout 10s;
        proxy_read_timeout    120s;
    }
    location /category-thumbnails/ {
        set $minio_upstream_cat http://minio:9000;
        proxy_pass $minio_upstream_cat;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version      1.1;
        proxy_request_buffering off;
        client_max_body_size    10m;
        proxy_connect_timeout   10s;
        proxy_send_timeout      120s;
        proxy_read_timeout      120s;
    }
    # ── Spring API (2026-07-23 임시 비활성) ──────────────────────────────
    # modera-spring 컨테이너가 없어 upstream 해석에 실패한다. 이 블록이 살아 있으면
    # nginx 가 설정 로드를 거부해 reload/restart 시 프록시 전체가 죽는다.
    # 백엔드가 modera-spring 을 띄우면 아래 3개 블록의 주석을 되돌릴 것.
    #
    # location /api/v1/ {
    #     proxy_pass http://modera-spring:8080;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }
    #
    # location /swagger-ui/ {
    #     proxy_pass http://modera-spring:8080;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }
    #
    # location /v3/api-docs {
    #     proxy_pass http://modera-spring:8080;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }

    location / {
        return 200 'infra alive over https\n';
        add_header Content-Type text/plain;
    }
}
# ── Spring API 전용 포트 (2026-07-28 임시 — /api/v1/ 경로 정리 전까지) ──
# ⚠️ 원래 이 자리에 Lightsail 방화벽 관련 경고가 있었으나 문장이 유실됐다.
#    8443 이 막혀 접근이 안 되면, 위 주석 처리된 Spring 블록을 modera-api 로
#    살리는 경로 전환으로 갈 것(그때 /api/v1/ 은 AI 와 충돌하므로 한쪽이 옮겨야 한다).
server {
    listen 8443 ssl;
    http2 on;
    server_name ${PUBLIC_HOST};

    ssl_certificate     /etc/letsencrypt/live/${PUBLIC_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PUBLIC_HOST}/privkey.pem;

    # Docker 내장 DNS. proxy_pass에 변수를 쓰면 nginx가 기동 시점이 아니라 요청 시점에
    # 호스트명을 다시 해석한다. Jenkins 배포로 컨테이너가 재생성되며 IP가 바뀌어도
    # 502가 나지 않는다(리터럴로 쓰면 기동 시 1회만 해석해 옛 IP에 갇힌다).
    resolver 127.0.0.11 valid=10s;

    # Grafana 모니터링 대시보드. resolver + 변수 패턴은 아래 location과 동일한 이유
    # (컨테이너 재생성 시 502 방지).
    location /grafana/ {
        set $grafana_upstream http://grafana:3000;
        proxy_pass $grafana_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    location / {
        set $api_upstream http://modera-api:8080;
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 10m;
    }
}
