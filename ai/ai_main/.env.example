# 자격증명 (필수, 기본값 없음)
GEMINI_API_KEY=
INTERNAL_TOKEN=

# Spring 내부 API
SPRING_BASE_URL=http://spring-api:8080

# S3
S3_BUCKET=
AWS_REGION=ap-northeast-2

# OpenSearch (검색 — FastAPI 전담). 같은 호스트면 localhost, 보안 끄면 인증 불필요.
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=screenshot_kb

# 모델
LLM_MODEL_NAME=gemini-3.5-flash
VISION_MODEL_NAME=gemini-3.5-flash
EMBEDDING_MODEL_NAME=gemini-embedding-2

# 분류 파라미터
SIMILARITY_THRESHOLD=0.80
DEFAULT_MAX_TAGS=10
HTTP_TIMEOUT=30

# 대량 처리 안정성
MAX_CONCURRENT_STAGES=4      # 동시에 처리할 단계 수 (Gemini 폭주/429 방지)
GEMINI_MAX_ATTEMPTS=5        # 429 재시도 횟수
GEMINI_BACKOFF_BASE=1.0      # 재시도 백오프 기준(초), 지수 증가
GEMINI_BACKOFF_MAX=30        # 백오프 상한(초)
