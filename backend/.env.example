# modera-backend 환경변수 템플릿 (SOA 재구성 이후 버전)
#
# 이 프로젝트는 서버가 2개(api-server, analysis-worker)라 .env도 앱마다 따로 관리하는
# 편이 헷갈리지 않는다. 아래 값을 참고해서 실행 방식에 맞게 직접 export 하거나,
# IDE의 Run Configuration 환경변수로 등록해서 쓴다. (.env 파일 자체를 자동으로
# 읽어들이는 코드는 없다 — Spring Boot는 OS 환경변수/실행 인자로만 값을 받는다.)
#
# ⚠️ 실제 비밀값은 이 파일에 절대 적지 않는다. 값은 항상 비워둔 채 커밋한다.
# ⚠️ local-infra/docker-compose.yml 안의 더미 값(localdev, minioadmin 등)은
#    로컬 전용으로 허용된 예외다 — 그 바깥에서는 절대 하드코딩하지 않는다.

# ══════════════════════════════════════════════════════════════
# api-server
# ══════════════════════════════════════════════════════════════

# ── Security ────────────────────────────────────────────────
# JWT 서명 키. 반드시 base64 문자열이어야 한다(하이픈 등 일반 문자열을 넣으면
# JwtTokenProvider가 기동 시점에 base64 디코딩하다 실패한다). 기본값 없음.
# 생성: openssl rand -base64 32
JWT_SECRET=

# MinIO ObjectCreated webhook 인증 토큰. POST /internal/storage/events 헤더
# X-Webhook-Token과 비교한다. local 프로필은 기본값(local-dev-webhook-token)이
# 있어 비워둬도 되지만, docker/prod 프로필에서는 명시적으로 채워야 한다.
MINIO_WEBHOOK_TOKEN=

# ── Database (PostgreSQL, api-db) ──────────────────────────────
# local 프로필 기본값: localhost:5433/modera_api/api_admin/localdev
# (local-infra가 host 5432 대신 5433으로 노출하기 때문 — README "포트" 절 참고)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# ── Redis ───────────────────────────────────────────────────
# local 프로필 기본값: localhost:6380 (host 6379 대신 — README "포트" 절 참고)
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ── Object Storage (S3 호환 / MinIO) ────────────────────────
# internal: 서버가 MinIO에 접근·서명할 때 / public: presigned URL에 노출할 호스트
# local 프로필 기본값: 둘 다 http://localhost:9002
S3_INTERNAL_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=
S3_BUCKET_PICTURES=
S3_BUCKET_THUMBNAILS=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── 선택 항목 (미지정 시 코드의 기본값 사용, prod 전용) ───────
SERVER_URL=
DB_POOL_MAX=
DB_POOL_MIN=

# ══════════════════════════════════════════════════════════════
# analysis-worker
# ══════════════════════════════════════════════════════════════

# ── Database (PostgreSQL, analysis-db) ─────────────────────────
# local 프로필 기본값: localhost:5434/modera_analysis/analysis_admin/localdev
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# ── Redis (api-server와 같은 Redis 인스턴스, Streams로만 통신) ─
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# ── AI 분석 클라이언트 ──────────────────────────────────────
# mock: AI 서버 없이 고정값+랜덤 임베딩 반환(로컬 개발 기본값)
# fastapi: 실제 AI 서버 호출(AI_SERVER_URL 필수)
ANALYSIS_CLIENT=
AI_SERVER_URL=
