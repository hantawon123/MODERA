# modera backend 환경변수 템플릿
#
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 .gitignore 처리됨)
#   cp .env.example .env
#
# ⚠️ 실제 비밀값은 이 파일에 절대 적지 않는다. 값은 항상 비워둔 채 커밋한다.

# ── Security ────────────────────────────────────────────────
# JWT 서명 키 (Base64 인코딩된 랜덤 바이트). 기본값 없음 — 미주입 시 앱 기동 실패.
# 생성 예: openssl rand -base64 32
JWT_SECRET=

# ── Database (PostgreSQL) ───────────────────────────────────
# DB 호스트. local = localhost (SSH 터널), prod = postgres (컨테이너명)
DB_HOST=
# DB 포트
DB_PORT=
# 데이터베이스 이름
DB_NAME=
# DB 접속 계정
DB_USERNAME=
# DB 접속 비밀번호. 기본값 없음 — 미주입 시 앱 기동 실패.
DB_PASSWORD=

# ── Redis ───────────────────────────────────────────────────
# Redis 호스트. local = localhost, prod = redis (컨테이너명)
REDIS_HOST=
# Redis 포트
REDIS_PORT=
# Redis 비밀번호. 인증을 안 걸었다면 비워둔다.
REDIS_PASSWORD=

# ── Object Storage (S3 호환 / MinIO) ────────────────────────
# S3 API 엔드포인트 URL
S3_ENDPOINT=
# 리전. MinIO 는 형식만 맞으면 되므로 임의 값 사용 가능.
S3_REGION=
# 버킷 이름
S3_BUCKET=
# 액세스 키
S3_ACCESS_KEY=
# 시크릿 키
S3_SECRET_KEY=

# ── 선택 항목 (미지정 시 코드의 기본값 사용) ────────────────
# Swagger 서버 목록에 노출할 배포 도메인 (prod 전용)
SERVER_URL=
# HikariCP 커넥션 풀 최대/최소 (prod 전용)
DB_POOL_MAX=
DB_POOL_MIN=
