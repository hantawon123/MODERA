# infra/docker-compose.yml 이 참조하는 환경변수 목록.
# 실제 값은 서버 /home/ubuntu/infra/.env 에만 존재한다 (커밋 금지 — .gitignore 처리됨).
# 새 서버에 구축할 때 이 파일을 .env 로 복사한 뒤 값을 채울 것.

# PostgreSQL (postgres 서비스 + init 스크립트)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
API_DB_PASSWORD=
ANALYSIS_DB_PASSWORD=

# MinIO
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Kakao OAuth (앱 compose 쪽에서 함께 참조)
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=
KAKAO_CLIENT_SECRET=
