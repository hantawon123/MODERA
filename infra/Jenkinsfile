pipeline {
    agent any

    triggers {
        // 3분마다 Git 변경사항을 확인
        pollSCM('H/3 * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checkout from SCM'
                checkout scm
            }
        }

        // ==========================================
        // 2. AI Server 배포 단계 (신규 추가)
        // ==========================================
        stage('AI Build') {
            // Git 레포지토리 내 'ai/**' 폴더 안의 파일이 수정/커밋되었을 때만 실행.
            // 단, 같은 커밋을 재빌드하면 changelog 가 비어 changeset 이 무조건 거짓이 된다
            // ("Warning, empty changelog"). 수동 실행은 의도가 명확하므로 그대로 진행한다.
            when {
                anyOf {
                    changeset "ai/**"
                    expression { !currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause').isEmpty() }
                }
            }
            steps {
                echo 'Docker image build for AI Server'
                // 실제 Dockerfile 및 소스가 위치한 폴더는 ai/ai_main
                // docker-compose.yml(/home/ubuntu/app/AI)이 참조하는 이미지명(ai-main)과 태그를 맞춘다
                dir('ai/ai_main') {
                    sh 'docker build -t ai-main:${BUILD_NUMBER} -t ai-main:latest .'
                    // nori 포함 OpenSearch 이미지는 레지스트리에 없는 로컬 전용 이미지다.
                    // 없으면 compose 가 pull 을 시도하다 실패하므로 여기서 만들어 둔다.
                    // 이미 있으면 건너뛴다(재생성되면 opensearch 컨테이너가 함께 재시작된다).
                    sh '''
                        if ! docker image inspect ai-opensearch-nori:latest >/dev/null 2>&1; then
                            echo "ai-opensearch-nori 이미지가 없어 새로 빌드한다"
                            docker build -t ai-opensearch-nori:latest -f opensearch.Dockerfile .
                        fi
                    '''
                }
                // 빌드 번호 태그가 계속 쌓여 디스크를 채운다. 최근 3개만 남긴다.
                // ponytail: 숫자 태그만 훑는 단순 방식. 태그 규칙이 늘면 라벨 기반으로 바꿀 것.
                sh '''
                    docker images ai-main --format '{{.Tag}}' \
                        | grep -E '^[0-9]+$' | sort -rn | tail -n +4 \
                        | xargs -r -I{} docker rmi ai-main:{} || true
                '''
            }
        }

        stage('AI Deploy') {
            when {
                anyOf {
                    changeset "ai/**"
                    expression { !currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause').isEmpty() }
                }
            }
            steps {
                echo 'Sync compose file from this repo (레포가 단일 진실 공급원)'
                sh '''
                    set -e
                    mkdir -p /home/ubuntu/app/AI
                    cp ai/ai_main/docker-compose.yml /home/ubuntu/app/AI/docker-compose.yml
                '''
                echo 'Sync .env from Jenkins credential'
                withCredentials([file(credentialsId: 'ai-server-dotenv', variable: 'AI_DOTENV')]) {
                    // 기존 .env 가 다른 계정(ubuntu/root) 소유라 덮어쓰기가 막힌다.
                    // 디렉터리 쓰기 권한은 있으므로 지우고 새로 만든다(새 파일은 Jenkins 소유).
                    sh '''
                        set -e
                        cp "$AI_DOTENV" /home/ubuntu/app/AI/.env.new
                        chmod 600 /home/ubuntu/app/AI/.env.new
                        # mv 는 디렉터리 권한만 있으면 되고(rename), 교체가 원자적이라
                        # .env 가 잠시라도 사라지는 구간이 없다.
                        mv -f /home/ubuntu/app/AI/.env.new /home/ubuntu/app/AI/.env
                    '''
                }
                echo 'Recreate AI Server container with new image'
                sh '''
                    set -e
                    cd /home/ubuntu/app/AI
                    # opensearch 는 없을 때만 생성한다. --no-deps 가 없으면
                    # --force-recreate 가 의존 서비스인 opensearch 까지 재생성한다.
                    docker compose up -d opensearch
                    # Dashboards 도 없을 때만 생성한다(--no-deps: opensearch 재생성 방지).
                    docker compose up -d --no-deps opensearch-dashboards
                    docker compose up -d --force-recreate --no-deps ai-service
                '''
                echo 'AI Server Health check'
                // Dockerfile 의 HEALTHCHECK(/health) 결과를 그대로 읽는다.
                // 컨테이너 내부 기준이라 Jenkins 가 호스트에 있든 컨테이너 안에 있든 동작한다.
                sh '''
                    cd /home/ubuntu/app/AI
                    cid=$(docker compose ps -q ai-service)
                    for i in $(seq 1 30); do
                        status=$(docker inspect -f '{{.State.Health.Status}}' "$cid")
                        [ "$status" = healthy ] && exit 0
                        [ "$status" = unhealthy ] && break
                        sleep 2
                    done
                    echo "health check failed (status=$status); recent logs:"
                    docker compose logs --tail=50 ai-service
                    exit 1
                '''
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished.'
        }
        success {
            echo 'Build and Deploy succeeded.'
        }
        failure {
            echo 'Build or Deploy failed.'
        }
    }
}