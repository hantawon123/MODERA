# infra/app-spring/docker-compose.yml 이 참조하는 환경변수 목록.
# 실제 값은 서버 /home/ubuntu/app/spring/.env 에만 존재한다 (커밋 금지).
# 새 서버 구축 시 이 파일을 .env 로 복사해 값을 채울 것.
# Firebase 서비스계정 JSON 은 별도로 /opt/modera/secrets/ 에 배치해야 한다
# (compose 가 read-only 마운트).

# DB (infra postgres 의 계정과 일치해야 함 — infra/.env.example 참고)
API_DB_PASSWORD=
ANALYSIS_DB_PASSWORD=

# 인증
JWT_SECRET=

# MinIO / S3
S3_PUBLIC_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MINIO_WEBHOOK_TOKEN=

# 서버 간 통신
AI_SERVER_URL=
INTERNAL_TOKEN=

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=
KAKAO_CLIENT_SECRET=
KAKAO_ALLOWED_APP_IDS=
