# 자격증명 (필수, 기본값 없음)
GEMINI_API_KEY=
INTERNAL_TOKEN=

# Spring 내부 API
SPRING_BASE_URL=http://spring-api:8080

# S3
S3_BUCKET=
AWS_REGION=ap-northeast-2

# 모델
LLM_MODEL_NAME=gemini-3.5-flash
VISION_MODEL_NAME=gemini-3.5-flash
EMBEDDING_MODEL_NAME=gemini-embedding-2

# 분류 파라미터
SIMILARITY_THRESHOLD=0.80
DEFAULT_MAX_TAGS=10
HTTP_TIMEOUT=30
